{
  "name": "flow-analyzer",
  "version": "1.0.0",
  "type": "module",
  "main": "main.js",
  "bin": {
    "flowAnalyzer": "main.js"
  },
  "scripts": {
    "app:pack": "npm run app:build && cd build && npm pack",
    "app:build": "npm run clean && node local-scripts/package-app.js",
    "clean": "rimraf build && rimraf client\\dist && rimraf api\\dist",
    "build": "tsc && if not exist build\\api mkdir build\\api && if not exist build\\client mkdir build\\client",
    "start:dev": "cross-env NODE_ENV=development tsx main.ts",
    "start:prod": "npm run app:build && cross-env NODE_ENV=production node build/main.js",
    "mcp:server:dev": "tsx mcp-servers/mcp-server.ts",
    "mcp:server:inspect": "set DANGEROUSLY_OMIT_AUTH=true && npx @modelcontextprotocol/inspector npm run mcp:server:dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.6.0",
    "@types/node-localstorage": "^1.3.3",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.8.6",
    "@langchain/anthropic": "^1.0.0",
    "@langchain/core": "^1.0.1",
    "@langchain/google-genai": "^1.0.0",
    "@langchain/ollama": "^1.0.0",
    "@langchain/openai": "^1.0.0",
    "@modelcontextprotocol/inspector": "^0.16.8",
    "@modelcontextprotocol/sdk": "^1.18.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "fs-extra": "^11.3.2",
    "langchain": "^1.0.1",
    "mime": "^4.1.0",
    "node-localstorage": "^3.0.5",
    "octokit": "^5.0.3",
    "tsx": "^4.20.6",
    "zod": "^3.25.76"
  }
}
